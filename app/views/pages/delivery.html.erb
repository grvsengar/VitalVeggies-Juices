<% content_for :title, "Delivery Information" %>
<% content_for :meta_description, "See delivery fees, free-delivery thresholds, and Bengaluru neighborhood coverage for Vital Veggies & Juices." %>

<section class="page-hero page-hero--editorial">
  <div class="container">
    <p class="eyebrow">Delivery information</p>
    <h1>Simple delivery rules for customers</h1>
    <p>Clear expectations on fees, free-delivery thresholds, local coverage, and order-status flow.</p>
  </div>
</section>

<section class="section">
  <div class="container split-grid">
    <div class="summary-card editorial-panel">
      <p>Standard delivery is <%= money(Cart::STANDARD_DELIVERY_FEE) %> for orders under <%= money(Cart::DELIVERY_THRESHOLD) %>. Orders above that threshold qualify for free local delivery.</p>
      <p>Typical delivery areas cover nearby Bengaluru neighborhoods such as Indiranagar, Domlur, Halasuru, CV Raman Nagar, and Koramangala, with same-day slots for orders placed before noon.</p>
    </div>
    <div class="summary-card editorial-panel">
      <h2>Order status flow</h2>
      <div class="summary-row"><span>Pending</span><strong>Order received</strong></div>
      <div class="summary-row"><span>Confirmed</span><strong>Stock assigned</strong></div>
      <div class="summary-row"><span>Preparing</span><strong>Packed for dispatch</strong></div>
      <div class="summary-row"><span>Out for delivery</span><strong>Driver assigned</strong></div>
      <% if @featured_promotion %>
        <p class="summary-note">Current offer: <strong><%= @featured_promotion.promo_code %></strong> for <%= @featured_promotion.title %>.</p>
      <% end %>
    </div>
  </div>
</section>

<section class="section section--soft">
  <div class="container">
    <div class="section-heading section-heading--stacked">
      <div>
        <p class="eyebrow">Service areas</p>
        <h2>Neighborhood pages for Bengaluru search intent</h2>
        <p>These pages connect delivery coverage with area-specific discovery instead of leaving local intent only in broad site copy.</p>
      </div>
    </div>

    <div class="coverage-grid">
      <% service_areas.each do |area| %>
        <article class="coverage-card">
          <p class="eyebrow"><%= area.name %></p>
          <h3><%= area.hero_title %></h3>
          <p><%= area.intro %></p>
          <%= link_to "Explore #{area.name}", location_page_path(area.slug), class: "text-link" %>
        </article>
      <% end %>
    </div>
  </div>
</section>
