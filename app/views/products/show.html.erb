<% content_for :title, @product.name %>
<% content_for :meta_description, @product.description %>

<section class="page-hero page-hero--catalog">
  <div class="container">
    <p class="eyebrow"><%= @product.category.name %> / <%= @product.product_kind.humanize %></p>
    <h1><%= @product.name %></h1>
    <p><%= @product.description %></p>
  </div>
</section>

<section class="section">
  <div class="container product-detail">
    <div class="product-detail__media product-detail__media--<%= @product.product_kind %>">
      <img src="<%= product_image_path(@product) %>" alt="<%= @product.name %>" decoding="async" fetchpriority="high">
    </div>
    <div class="product-detail__content summary-card editorial-panel">
      <p class="lead"><%= @product.description %></p>
      <% if @product.ingredients.present? %>
        <p><strong>Ingredients:</strong> <%= @product.ingredients %></p>
      <% end %>
      <div class="badge-row">
        <% if @product.organic? %><span class="badge">Organic</span><% end %>
        <% if @product.local? %><span class="badge">Local</span><% end %>
        <% if @product.seasonal? %><span class="badge">Seasonal</span><% end %>
      </div>
      <%= render "products/detail_purchase", product: @product %>
    </div>
  </div>
</section>

<section class="section section--soft">
  <div class="container split-grid">
    <div>
      <div class="section-heading">
        <div>
          <p class="eyebrow">Customer ratings</p>
          <h2>Product reviews</h2>
        </div>
      </div>
      <div class="review-list">
        <% @reviews.each do |review| %>
          <article class="review-card summary-card">
            <strong><%= stars_for(review.rating) %></strong>
            <h3><%= review.title %></h3>
            <p><%= review.body %></p>
            <span><%= review.customer_name %></span>
          </article>
        <% end %>
      </div>
    </div>

    <div class="review-form-card form-card">
      <h2>Leave a review</h2>
      <%= form_with model: [@product, @review], class: "stack-form" do |form| %>
        <%= form.text_field :customer_name, placeholder: "Your name", class: "field" %>
        <%= form.text_field :title, placeholder: "Review title", class: "field" %>
        <%= form.select :rating, options_for_select(1..5), {}, class: "field" %>
        <%= form.text_area :body, rows: 5, placeholder: "Share your experience", class: "field" %>
        <%= form.submit "Submit review", class: "button button--primary" %>
      <% end %>
    </div>
  </div>
</section>

<% if @related_products.any? %>
  <section class="section">
    <div class="container">
      <div class="section-heading">
        <div>
          <p class="eyebrow">You may also like</p>
          <h2>More from <%= @product.category.name %></h2>
        </div>
      </div>
      <div class="product-grid">
        <%= render partial: "shared/product_card", collection: @related_products, as: :product %>
      </div>
    </div>
  </section>
<% end %>
