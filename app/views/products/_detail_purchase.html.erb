<%= turbo_frame_tag dom_id(product, :detail_purchase), class: "product-live-region product-detail__purchase" do %>
  <div class="price-row">
    <strong><%= money(product.price) %></strong>
    <span><%= product.stock_label %></span>
  </div>
  <%= form_with url: cart_items_path, method: :post, class: "add-to-cart-form", data: { turbo_frame: "_top" } do |form| %>
    <%= form.hidden_field :product_id, value: product.id %>
    <%= form.number_field :quantity, value: 1, min: 1, step: 1, inputmode: "numeric", class: "field field--small", disabled: !product.available_for_purchase? %>
    <%= form.submit "Add to cart", class: "button button--primary", disabled: !product.available_for_purchase? %>
  <% end %>
<% end %>
