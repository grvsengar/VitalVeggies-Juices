<article class="product-card" data-controller="tilt-card" data-action="mousemove->tilt-card#move mouseleave->tilt-card#reset">
  <div class="product-card__media product-card__media--<%= product.product_kind %>" style="view-transition-name: <%= product_transition_name(product) %>">
    <%= render "shared/product_stock_badge", product: product %>
    <img src="<%= product_image_path(product) %>" alt="<%= product.name %>" loading="lazy" decoding="async">
  </div>
  <div class="product-card__body">
    <p class="product-card__category"><%= product.category.name %></p>
    <div class="product-card__eyebrow">
      <span><%= product.product_kind.humanize %></span>
      <% if product.organic? %><span>Organic</span><% end %>
      <% if product.local? %><span>Local</span><% end %>
    </div>
    <h3><%= link_to product.name, product_path(product.slug) %></h3>
    <p><%= truncate(product.description, length: 65) %></p>
    <%= render "shared/product_card_purchase", product: product %>
  </div>
</article>
