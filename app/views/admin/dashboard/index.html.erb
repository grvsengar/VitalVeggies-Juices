<% content_for :title, "Admin Dashboard" %>

<section class="section">
  <div class="container">
    <div class="section-heading">
      <div>
        <p class="eyebrow">Admin dashboard</p>
        <h2>Business control overview</h2>
      </div>
    </div>

    <%= render "admin/dashboard/metrics", metrics: @metrics %>

    <div class="portal-content-grid">
      <div class="summary-card">
        <h2>Access responsibility</h2>
        <ul class="portal-list">
          <% current_user.responsibilities.each do |responsibility| %>
            <li><%= responsibility %></li>
          <% end %>
        </ul>
        <p><%= link_to "Create or review managers", admin_managers_path, class: "text-link" %></p>
      </div>

      <%= render "admin/dashboard/low_stock_watchlist", products: @low_stock_products %>
    </div>

    <div class="summary-card">
      <div class="section-heading">
        <div><h2>Recent manager invitations</h2></div>
        <%= link_to "Open manager access", admin_managers_path, class: "text-link" %>
      </div>
      <div class="portal-table">
        <% @recent_managers.each do |manager| %>
          <div class="portal-table__row">
            <span><%= manager.email %></span>
            <span><%= manager.registered? ? "Registered" : "Invitation pending" %></span>
          </div>
        <% end %>
      </div>
    </div>

    <div class="summary-card">
      <div class="section-heading">
        <div><h2>Recent orders</h2></div>
        <%= link_to "Manage orders", admin_orders_path, class: "text-link" %>
      </div>
      <div class="portal-table">
        <% @recent_orders.each do |order| %>
          <div class="portal-table__row">
            <span><%= link_to order.order_number, admin_order_path(order) %> · <%= order.customer_name %></span>
            <span><%= order.status.humanize %> · <%= money(order.total) %></span>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</section>
