<% content_for :title, "Catalog Categories" %>

<section class="section">
  <div class="container">
    <div class="section-heading">
      <div>
        <p class="eyebrow">Admin</p>
        <h2>Category management</h2>
        <p>Categories control storefront grouping, filters, and product organization.</p>
      </div>
      <div class="admin-action-row">
        <%= link_to "Back to products", admin_products_path, class: "button button--ghost" %>
        <%= link_to "Add category", new_admin_category_path, class: "button button--primary" %>
      </div>
    </div>

    <div class="portal-table portal-table--cards">
      <% @categories.each do |category| %>
        <article class="summary-card">
          <div class="portal-table__row">
            <strong><%= category.name %></strong>
            <span><%= category.active? ? "Active" : "Hidden" %></span>
          </div>
          <p><%= category.slug %> · Position <%= category.position %></p>
          <p><%= pluralize(category.products.count, "product") %></p>
          <div class="admin-action-row">
            <%= link_to "Edit category", edit_admin_category_path(category), class: "button button--ghost" %>
            <%= button_to "Delete", admin_category_path(category), method: :delete, class: "button button--ghost", form: { data: { turbo_confirm: "Delete #{category.name}? Categories with products will be deactivated instead." } } %>
          </div>
        </article>
      <% end %>
    </div>
  </div>
</section>
