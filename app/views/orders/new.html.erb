<% content_for :title, "Checkout" %>

<section class="page-hero">
  <div class="container">
    <p class="eyebrow">Checkout</p>
    <h1>Complete your order</h1>
    <p>Secure checkout structure with payment method selection, delivery details, and order tracking after purchase.</p>
  </div>
</section>

<section class="section">
  <div class="container cart-layout">
    <div class="form-card">
      <% if @order.errors.any? %>
        <div class="flash flash--alert">
          <%= @order.errors.full_messages.to_sentence %>
        </div>
      <% end %>
      <%= form_with model: @order, class: "stack-form" do |form| %>
        <% if buyer_signed_in? && @addresses&.any? %>
          <div class="address-selection" style="grid-column: span 2; margin-bottom: 1.5rem;">
            <h2>Delivery Address</h2>
            <div class="stack-form">
              <% @addresses.each do |address| %>
                <label class="address-option card-radio">
                  <%= radio_button_tag :address_id, address.id, address.is_default?, class: "address-radio", data: { type: "saved" } %>
                  <div class="address-details">
                    <strong><%= address.name.presence || "Address" %></strong>
                    <p><%= address.full_address %></p>
                  </div>
                </label>
              <% end %>
              <label class="address-option card-radio">
                <%= radio_button_tag :address_id, "", false, id: "address_id_new", class: "address-radio", data: { type: "new" } %>
                <div class="address-details">
                  <strong>Use a different address</strong>
                  <p>Enter a new delivery address below</p>
                </div>
              </label>
            </div>
          </div>
        <% end %>

        <div id="new-address-fields" class="two-column" style="<%= 'display: none;' if buyer_signed_in? && @addresses&.any? && @addresses.any?(&:is_default?) %>">
          <%= form.text_field :customer_name, placeholder: "Full name", class: "field" %>
          <%= form.email_field :email, placeholder: "Email address", class: "field" %>
          <%= form.telephone_field :phone, placeholder: "Phone number", class: "field" %>
          <%= form.select :delivery_window, options_for_select(["8 AM - 11 AM", "11 AM - 2 PM", "2 PM - 5 PM", "5 PM - 8 PM"], @order.delivery_window), { include_blank: "Preferred delivery window" }, class: "field" %>
          <%= form.text_field :address_line1, placeholder: "Address line 1", class: "field" %>
          <%= form.text_field :address_line2, placeholder: "Address line 2", class: "field" %>
          <%= form.text_field :city, placeholder: "City", class: "field" %>
          <%= form.text_field :state, placeholder: "State", class: "field" %>
          <%= form.text_field :postal_code, placeholder: "Postal code", class: "field" %>
          <%= form.select :payment_method, options_for_select([["Cash on delivery", "cash_on_delivery"], ["Card on delivery", "card_on_delivery"], ["Online payment gateway ready", "online_gateway"]], @order.payment_method), {}, class: "field" %>
        </div>

        <% if buyer_signed_in? && @addresses&.any? %>
          <script>
            document.addEventListener('DOMContentLoaded', function() {
              const radios = document.querySelectorAll('.address-radio');
              const newAddressFields = document.getElementById('new-address-fields');
              const fields = newAddressFields.querySelectorAll('.field');

              function toggleFields() {
                const selected = document.querySelector('.address-radio:checked');
                if (selected && selected.dataset.type === 'saved') {
                  newAddressFields.style.display = 'none';
                  fields.forEach(f => {
                    if (f.name !== 'order[payment_method]' && f.name !== 'order[delivery_window]') {
                      f.disabled = true;
                    }
                  });
                } else {
                  newAddressFields.style.display = 'grid';
                  fields.forEach(f => f.disabled = false);
                }
              }

              radios.forEach(r => r.addEventListener('change', toggleFields));
              toggleFields(); // Initial state
            });
          </script>
        <% end %>
        <%= form.text_area :notes, rows: 4, placeholder: "Order notes, gate code, or produce preferences", class: "field" %>
        <%= form.submit "Place order", class: "button button--primary" %>
      <% end %>
    </div>

    <aside class="summary-card">
      <h2>Order summary</h2>
      <% if current_cart.stock_issue_items.any? %>
        <div class="flash flash--alert">
          Some items in your cart exceed current stock. Update the cart before placing the order.
        </div>
      <% end %>
      <% current_cart.items.each do |item| %>
        <div class="summary-row">
          <span><%= item.product.name %> x <%= item.quantity %></span>
          <strong><%= money(item.total_price) %></strong>
        </div>
      <% end %>
      <div class="summary-row"><span>Subtotal</span><strong><%= money(current_cart.subtotal) %></strong></div>
      <div class="summary-row"><span>Discount</span><strong>-<%= money(current_cart.discount_for(@promotion)) %></strong></div>
      <div class="summary-row"><span>Delivery</span><strong><%= money(current_cart.delivery_fee) %></strong></div>
      <div class="summary-row summary-row--total"><span>Total</span><strong><%= money(current_cart.subtotal - current_cart.discount_for(@promotion) + current_cart.delivery_fee) %></strong></div>
      <p class="summary-note">For live gateway processing, connect Stripe or PayPal credentials in environment variables and replace the placeholder payment option flow.</p>
    </aside>
  </div>
</section>
