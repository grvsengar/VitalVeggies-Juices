<% content_for :title, "Manager Inventory" %>

<section class="manager-page">
  <div class="manager-page__header">
    <div>
      <h1>Inventory</h1>
      <p><%= Date.current.strftime("%A %d %B, %Y") %></p>
    </div>
    <%= link_to "Low stock only", manager_inventory_index_path(stock: "low_stock"), class: "manager-primary-action" %>
  </div>

  <%= form_with url: manager_inventory_index_path, method: :get, class: "manager-toolbar" do |form| %>
    <%= form.search_field :q, value: params[:q], placeholder: "Search products...", class: "manager-search" %>
    <%= form.collection_select :category_id, @categories, :id, :name, { include_blank: "All categories", selected: params[:category_id] }, class: "manager-select" %>
    <%= form.select :stock, [["All stock", ""], ["Sold out", "sold_out"], ["Low stock", "low_stock"], ["Healthy", "healthy"]], { selected: params[:stock] }, class: "manager-select" %>
    <%= form.submit "Filter", class: "manager-primary-action" %>
  <% end %>

  <article class="manager-card">
    <div class="manager-table manager-table--products">
      <div class="manager-table__head">
        <span>Product</span>
        <span>SKU</span>
        <span>Category</span>
        <span>Price</span>
        <span>Stock</span>
        <span>Status</span>
      </div>
      <% @products.each do |product| %>
        <%= render "manager/inventory/product_row", product: product %>
      <% end %>
    </div>
  </article>
</section>
