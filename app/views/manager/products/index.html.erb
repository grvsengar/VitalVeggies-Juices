<% content_for :title, "Manager Products" %>

<section class="manager-page mgr-page">
  <div class="manager-page__header mgr-page__header">
    <div>
      <h1 class="mgr-page-title">Products</h1>
      <p class="mgr-page-date"><%= Date.current.strftime("%A, %d %B %Y") %></p>
    </div>
    <div class="manager-action-row mgr-header-actions">
      <%= link_to new_manager_product_path, class: "manager-primary-action mgr-btn-primary" do %>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/>
        </svg>
        Add Product
      <% end %>
      <%= link_to "Update Stock", manager_inventory_index_path, class: "manager-secondary-action mgr-btn-secondary" %>
    </div>
  </div>

  <%= form_with url: manager_products_path, method: :get, class: "manager-toolbar" do |form| %>
    <%= form.search_field :q, value: params[:q], placeholder: "Search products...", class: "manager-search" %>
    <%= form.collection_select :category_id, @categories, :id, :name, { include_blank: "All categories", selected: params[:category_id] }, class: "manager-select" %>
    <%= form.select :kind, Product.product_kinds.keys.map { |kind| [kind.humanize, kind] }, { include_blank: "All types", selected: params[:kind] }, class: "manager-select" %>
    <%= form.select :status, [["All status", ""], ["Active", "active"], ["Hidden", "hidden"]], { selected: params[:status] }, class: "manager-select" %>
    <%= form.submit "Filter", class: "manager-primary-action" %>
  <% end %>

  <article class="manager-card mgr-card">
    <div class="manager-table manager-table--products mgr-table mgr-table--products">
      <div class="manager-table__head mgr-table__head">
        <span>Product</span>
        <span>SKU / Type</span>
        <span>Category</span>
        <span>Price</span>
        <span>Stock</span>
        <span>Status</span>
      </div>
      <% @products.each do |product| %>
        <%= render "manager/products/product_row", product: product %>
      <% end %>
    </div>
  </article>
</section>
