<%= link_to manager_order_path(order),
            id: dom_id(order, :manager_order_row),
            class: ["manager-table__row", ("manager-live-row manager-live-row--new" if local_assigns[:highlight])].compact.join(" ") do %>
  <strong><%= order.order_number %></strong>
  <span><%= order.customer_name %></span>
  <span><%= order.created_at.strftime("%b %d, %Y") %></span>
  <span><%= order.order_items.load.sum(&:quantity) %></span>
  <span><%= money(order.total) %></span>
  <span class="<%= payment_badge_class(order.payment_status) %>"><%= order.payment_status.humanize %></span>
  <span class="<%= order_status_badge_class(order.status) %>"><%= order.status.humanize %></span>
<% end %>
