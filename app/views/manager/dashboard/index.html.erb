<% content_for :title, "Manager Dashboard" %>

<section class="manager-page">
  <div class="manager-page__header">
    <div>
      <h1>Dashboard</h1>
      <p><%= Date.current.strftime("%A %d %B, %Y") %></p>
    </div>
    <%= link_to "Update inventory", manager_inventory_index_path, class: "manager-primary-action" %>
  </div>

  <div class="manager-metrics">
    <article class="manager-metric-card">
      <span>Open orders</span>
      <strong><%= @metrics[:pending_orders] %></strong>
      <small>Need fulfilment review</small>
    </article>
    <article class="manager-metric-card">
      <span>Out for delivery</span>
      <strong><%= @metrics[:out_for_delivery] %></strong>
      <small>Currently on route</small>
    </article>
    <article class="manager-metric-card">
      <span>Active products</span>
      <strong><%= @metrics[:active_products] %></strong>
      <small>Visible in storefront</small>
    </article>
    <article class="manager-metric-card">
      <span>Stock alerts</span>
      <strong><%= @metrics[:low_stock] %></strong>
      <small><%= @metrics[:sold_out] %> sold out</small>
    </article>
  </div>

  <div class="manager-grid">
    <article class="manager-card manager-card--wide">
      <div class="manager-card__header">
        <h2>Recent orders</h2>
        <%= link_to "View all orders", manager_orders_path, class: "manager-text-link" %>
      </div>

      <div class="manager-table">
        <div class="manager-table__head">
          <span>Order</span>
          <span>Customer</span>
          <span>Total</span>
          <span>Status</span>
        </div>
        <% @active_orders.each do |order| %>
          <%= link_to manager_order_path(order), class: "manager-table__row" do %>
            <strong><%= order.order_number %></strong>
            <span><%= order.customer_name %></span>
            <span><%= money(order.total) %></span>
            <span class="<%= order_status_badge_class(order.status) %>"><%= order.status.humanize %></span>
          <% end %>
        <% end %>
      </div>
    </article>

    <article class="manager-card">
      <div class="manager-card__header">
        <h2>Low stock alerts</h2>
        <%= link_to "Inventory", manager_inventory_index_path(stock: "low_stock"), class: "manager-text-link" %>
      </div>

      <div class="manager-stock-list">
        <% @low_stock_products.each do |product| %>
          <%= link_to edit_manager_inventory_path(product), class: "manager-stock-item" do %>
            <%= image_tag product_image_path(product), alt: product.name %>
            <span>
              <strong><%= product.name %></strong>
              <small><%= product.sku %></small>
            </span>
            <span class="<%= stock_badge_class(product) %>"><%= stock_badge(product) %></span>
          <% end %>
        <% end %>
      </div>
    </article>
  </div>
</section>
