<% content_for :title, "Manager Dashboard" %>

<%= turbo_stream_from "manager_dashboard" %>

<section class="manager-page">
  <div class="manager-page__header">
    <div>
      <h1>Dashboard</h1>
      <p><%= Date.current.strftime("%A %d %B, %Y") %></p>
    </div>
    <%= link_to "Update inventory", manager_inventory_index_path, class: "manager-primary-action" %>
  </div>

  <%= render "manager/dashboard/metrics", metrics: @metrics, analytics: @analytics %>
  <%= render "manager/dashboard/analytics", analytics: @analytics %>

  <div class="manager-grid">
    <%= render "manager/dashboard/recent_orders", orders: @recent_orders %>

    <%= render "manager/dashboard/low_stock_alerts", products: @low_stock_products %>
  </div>
</section>
