<% content_for :title, "Manager Dashboard" %>

<%
  hour = Time.current.hour
  greeting = if hour < 12 then "Good morning"
  elsif hour < 17 then "Good afternoon"
  else "Good evening"
  end
%>

<section class="manager-page mgr-page">
  <div class="manager-page__header mgr-page__header">
    <div>
      <p class="mgr-greeting"><%= greeting %>, <%= current_user.name.split(" ").first rescue "there" %> 👋</p>
      <h1 class="mgr-page-title">Dashboard</h1>
      <p class="mgr-page-date"><%= Date.current.strftime("%A, %d %B %Y") %></p>
    </div>
    <div class="mgr-header-actions">
      <%= link_to manager_inventory_index_path, class: "manager-primary-action mgr-btn-primary" do %>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/>
        </svg>
        Update Inventory
      <% end %>
    </div>
  </div>

  <%= render "manager/dashboard/metrics", metrics: @metrics %>

  <%= render "manager/dashboard/analytics", analytics: @analytics %>

  <div class="mgr-quick-actions">
    <%= link_to new_manager_product_path, class: "mgr-quick-btn" do %>
      <span class="mgr-quick-btn__icon mgr-quick-btn__icon--green">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/>
        </svg>
      </span>
      <span>New Product</span>
    <% end %>
    <%= link_to manager_orders_path, class: "mgr-quick-btn" do %>
      <span class="mgr-quick-btn__icon mgr-quick-btn__icon--blue">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2"/>
          <rect x="9" y="3" width="6" height="4" rx="1"/>
        </svg>
      </span>
      <span>View Orders</span>
    <% end %>
    <%= link_to manager_inventory_index_path, class: "mgr-quick-btn" do %>
      <span class="mgr-quick-btn__icon mgr-quick-btn__icon--orange">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 16V8a2 2 0 00-1-1.73l-7-4a2 2 0 00-2 0l-7 4A2 2 0 003 8v8a2 2 0 001 1.73l7 4a2 2 0 002 0l7-4A2 2 0 0021 16z"/>
        </svg>
      </span>
      <span>Inventory</span>
    <% end %>
    <%= link_to manager_categories_path, class: "mgr-quick-btn" do %>
      <span class="mgr-quick-btn__icon mgr-quick-btn__icon--purple">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/>
          <line x1="3" y1="6" x2="3.01" y2="6"/><line x1="3" y1="12" x2="3.01" y2="12"/><line x1="3" y1="18" x2="3.01" y2="18"/>
        </svg>
      </span>
      <span>Categories</span>
    <% end %>
  </div>

  <div class="manager-grid mgr-grid">
    <%= render "manager/dashboard/recent_orders", orders: @recent_orders %>
    <%= render "manager/dashboard/low_stock_alerts", products: @low_stock_products %>
  </div>
</section>
