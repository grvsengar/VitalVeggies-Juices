<%
  metrics = local_assigns[:metrics] || {
    pending_orders: Order.where(status: %i[pending confirmed preparing]).count,
    out_for_delivery: Order.out_for_delivery.count,
    low_stock: Product.active.where(stock_quantity: 0..5).count,
    sold_out: Product.active.where(stock_quantity: 0).count,
    active_products: Product.active.count
  }
%>

<div id="manager_dashboard_metrics" class="manager-metrics mgr-metrics product-live-region">
  <article class="manager-metric-card mgr-metric-card mgr-metric-card--blue">
    <div class="mgr-metric-card__top">
      <span class="mgr-metric-label">Open Orders</span>
      <span class="mgr-metric-icon">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2"/>
          <rect x="9" y="3" width="6" height="4" rx="1"/><line x1="9" y1="12" x2="15" y2="12"/><line x1="9" y1="16" x2="13" y2="16"/>
        </svg>
      </span>
    </div>
    <strong class="mgr-metric-value"><%= metrics[:pending_orders] %></strong>
    <div class="mgr-metric-footer">
      <span class="mgr-trend mgr-trend--up">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="23 6 13.5 15.5 8.5 10.5 1 18"/><polyline points="17 6 23 6 23 12"/>
        </svg>
        Needs fulfilment
      </span>
    </div>
  </article>

  <article class="manager-metric-card mgr-metric-card mgr-metric-card--orange">
    <div class="mgr-metric-card__top">
      <span class="mgr-metric-label">Out for Delivery</span>
      <span class="mgr-metric-icon">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect x="1" y="3" width="15" height="13" rx="1"/><path d="M16 8h4l3 3v5h-7V8z"/>
          <circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/>
        </svg>
      </span>
    </div>
    <strong class="mgr-metric-value"><%= metrics[:out_for_delivery] %></strong>
    <div class="mgr-metric-footer">
      <span class="mgr-trend mgr-trend--neutral">Currently on route</span>
    </div>
  </article>

  <article class="manager-metric-card mgr-metric-card mgr-metric-card--green">
    <div class="mgr-metric-card__top">
      <span class="mgr-metric-label">Active Products</span>
      <span class="mgr-metric-icon">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M20.59 13.41l-7.17 7.17a2 2 0 01-2.83 0L2 12V2h10l8.59 8.59a2 2 0 010 2.82z"/>
          <circle cx="7" cy="7" r="1.5" fill="currentColor"/>
        </svg>
      </span>
    </div>
    <strong class="mgr-metric-value"><%= metrics[:active_products] %></strong>
    <div class="mgr-metric-footer">
      <span class="mgr-trend mgr-trend--up">Visible in storefront</span>
    </div>
  </article>

  <article class="manager-metric-card mgr-metric-card mgr-metric-card--red">
    <div class="mgr-metric-card__top">
      <span class="mgr-metric-label">Stock Alerts</span>
      <span class="mgr-metric-icon">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"/>
          <line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/>
        </svg>
      </span>
    </div>
    <strong class="mgr-metric-value"><%= metrics[:low_stock] %></strong>
    <div class="mgr-metric-footer">
      <span class="mgr-trend mgr-trend--down"><%= metrics[:sold_out] %> sold out</span>
    </div>
  </article>
</div>
